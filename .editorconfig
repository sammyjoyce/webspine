root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{nix,yml,yaml,json,md}]
indent_size = 2

# Byte-exact inputs: latin1.html is deliberately ISO-8859-1.
[tests/fixtures/**]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
